
REPORT z25_po_management.

* Purchase Order Management System
* Features: PO creation, validation, display, status management,
* header ALV overview and item-level ALV overview with dynamic filters.

*---------------------------------------------------------------------*
* 1. DISPLAY TYPES
*---------------------------------------------------------------------*

TYPES: BEGIN OF ty_po_header_display,
         po_id         TYPE z25de_po_id,
         vendor_id     TYPE z25de_vendor_id,
         vendor_name   TYPE z25de_vendor_name,
         po_date       TYPE datum,
         delivery_date TYPE datum,
         currency      TYPE waers,
         total_amount  TYPE z25de_total_amount,
         status        TYPE z25de_status,
       END OF ty_po_header_display.

TYPES: BEGIN OF ty_po_item_display,
         item_no      TYPE z25de_item_no,
         material_id  TYPE z25de_material_id,
         material_name TYPE z25de_material_name,
         quantity     TYPE z25de_quantity,
         unit         TYPE meins,
         unit_price   TYPE z25de_unit_price,
         line_total   TYPE z25de_line_total,
         currency     TYPE waers,
       END OF ty_po_item_display.

TYPES ty_po_item_table TYPE STANDARD TABLE OF ty_po_item_display
                       WITH DEFAULT KEY.

TYPES: BEGIN OF ty_po_overview,
         po_id          TYPE z25de_po_id,
         vendor_id      TYPE z25de_vendor_id,
         vendor_name    TYPE z25de_vendor_name,
         po_date        TYPE datum,
         delivery_date  TYPE datum,
         total_amount   TYPE z25de_total_amount,
         currency       TYPE waers,
         status         TYPE z25de_status,
         status_text    TYPE char15,
       END OF ty_po_overview.

TYPES ty_po_overview_table TYPE STANDARD TABLE OF ty_po_overview
                            WITH DEFAULT KEY.

TYPES: BEGIN OF ty_po_item_overview,
         po_id          TYPE z25de_po_id,
         vendor_id      TYPE z25de_vendor_id,
         vendor_name    TYPE z25de_vendor_name,
         po_date        TYPE datum,
         item_no        TYPE z25de_item_no,
         material_id    TYPE z25de_material_id,
         material_name  TYPE z25de_material_name,
         quantity       TYPE z25de_quantity,
         unit           TYPE meins,
         unit_price     TYPE z25de_unit_price,
         line_total     TYPE z25de_line_total,
         currency       TYPE waers,
         status         TYPE z25de_status,
         status_text    TYPE char15,
       END OF ty_po_item_overview.

TYPES ty_po_item_overview_table TYPE STANDARD TABLE OF ty_po_item_overview
                                WITH DEFAULT KEY.


*---------------------------------------------------------------------*
* 2. CLASS DEFINITION - PO VALIDATOR
*---------------------------------------------------------------------*

CLASS lcl_po_validator DEFINITION.

  PUBLIC SECTION.

    METHODS:
      validate_vendor
        IMPORTING iv_vendor_id TYPE z25de_vendor_id
        RETURNING VALUE(rv_exists) TYPE abap_bool,

      validate_material
        IMPORTING iv_material_id TYPE z25de_material_id
        RETURNING VALUE(rv_exists) TYPE abap_bool,

      validate_quantity
        IMPORTING iv_quantity TYPE z25de_quantity
        RETURNING VALUE(rv_valid) TYPE abap_bool,

      validate_vendor_material
        IMPORTING
          iv_vendor_id TYPE z25de_vendor_id
          iv_material_id TYPE z25de_material_id
        RETURNING VALUE(rv_exists) TYPE abap_bool.

ENDCLASS.


*---------------------------------------------------------------------*
* 3. CLASS DEFINITION - PO DAO
*---------------------------------------------------------------------*

CLASS lcl_po_dao DEFINITION.

  PUBLIC SECTION.

    METHODS:
      get_vendor
        IMPORTING iv_vendor_id TYPE z25de_vendor_id
        EXPORTING es_vendor TYPE z25vendor,

      get_material
        IMPORTING iv_material_id TYPE z25de_material_id
        EXPORTING es_material TYPE z25material,

      display_purchase_order
        IMPORTING iv_po_id TYPE z25de_po_id
        EXPORTING
          es_header TYPE ty_po_header_display
          et_items TYPE ty_po_item_table.

ENDCLASS.


*---------------------------------------------------------------------*
* 4. CLASS DEFINITION - PO SERVICE
*---------------------------------------------------------------------*

CLASS lcl_po_service DEFINITION.

  PUBLIC SECTION.

    METHODS:
      calculate_item_total
        IMPORTING
          iv_quantity TYPE z25de_quantity
          iv_unit_price TYPE z25de_unit_price
        RETURNING VALUE(rv_total) TYPE z25de_line_total,

      calculate_po_total
        IMPORTING
          iv_po_id TYPE z25de_po_id
        RETURNING VALUE(rv_total) TYPE z25de_total_amount,

      create_purchase_order
        IMPORTING
          is_header TYPE z25po_header
          is_item TYPE z25po_item
        RETURNING VALUE(rv_success) TYPE abap_bool,

      update_po_status
        IMPORTING
          iv_po_id TYPE z25de_po_id
          iv_status TYPE z25de_status
        RETURNING VALUE(rv_success) TYPE abap_bool.

ENDCLASS.


*---------------------------------------------------------------------*
* 5. CLASS IMPLEMENTATION - PO VALIDATOR
*---------------------------------------------------------------------*

CLASS lcl_po_validator IMPLEMENTATION.

  METHOD validate_vendor.

    DATA lv_vendor_id TYPE z25de_vendor_id.

    CLEAR rv_exists.

    SELECT SINGLE vendor_id
      INTO lv_vendor_id
      FROM z25vendor
      WHERE vendor_id = iv_vendor_id.

    IF sy-subrc = 0.
      rv_exists = abap_true.
    ELSE.
      rv_exists = abap_false.
    ENDIF.

  ENDMETHOD.


  METHOD validate_material.

    DATA lv_material_id TYPE z25de_material_id.

    CLEAR rv_exists.

    SELECT SINGLE material_id
      INTO lv_material_id
      FROM z25material
      WHERE material_id = iv_material_id.

    IF sy-subrc = 0.
      rv_exists = abap_true.
    ELSE.
      rv_exists = abap_false.
    ENDIF.

  ENDMETHOD.


  METHOD validate_quantity.

    CLEAR rv_valid.

    IF iv_quantity > 0.
      rv_valid = abap_true.
    ELSE.
      rv_valid = abap_false.
    ENDIF.

  ENDMETHOD.


  METHOD validate_vendor_material.

  DATA lv_vendor_id TYPE z25de_vendor_id.

  CLEAR rv_exists.

  SELECT SINGLE vendor_id
    INTO lv_vendor_id
    FROM z25vendor_mat1
    WHERE vendor_id = iv_vendor_id
      AND material_id = iv_material_id.

  IF sy-subrc = 0.
    rv_exists = abap_true.
  ELSE.
    rv_exists = abap_false.
  ENDIF.

ENDMETHOD.

ENDCLASS.


*---------------------------------------------------------------------*
* 6. CLASS IMPLEMENTATION - PO DAO
*---------------------------------------------------------------------*

CLASS lcl_po_dao IMPLEMENTATION.

  METHOD get_vendor.

    CLEAR es_vendor.

    SELECT SINGLE *
      INTO es_vendor
      FROM z25vendor
      WHERE vendor_id = iv_vendor_id.

  ENDMETHOD.


  METHOD get_material.

    CLEAR es_material.

    SELECT SINGLE *
      INTO es_material
      FROM z25material
      WHERE material_id = iv_material_id.

  ENDMETHOD.


  METHOD display_purchase_order.

    CLEAR: es_header, et_items.

    "Retrieve PO header and vendor name
    SELECT SINGLE
      h~po_id
      h~vendor_id
      v~vendor_name
      h~po_date
      h~delivery_date
      h~currency
      h~total_amount
      h~status
      INTO CORRESPONDING FIELDS OF es_header
      FROM z25po_header AS h
      INNER JOIN z25vendor AS v
        ON h~vendor_id = v~vendor_id
      WHERE h~po_id = iv_po_id.

    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    "Retrieve all items and material names
    SELECT
      i~item_no
      i~material_id
      m~material_name
      i~quantity
      i~unit
      i~unit_price
      i~line_total
      i~currency
      INTO CORRESPONDING FIELDS OF TABLE et_items
      FROM z25po_item AS i
      INNER JOIN z25material AS m
        ON i~material_id = m~material_id
      WHERE i~po_id = iv_po_id
      ORDER BY i~item_no.

  ENDMETHOD.

ENDCLASS.


*---------------------------------------------------------------------*
* 7. CLASS IMPLEMENTATION - PO SERVICE
*---------------------------------------------------------------------*

CLASS lcl_po_service IMPLEMENTATION.

  METHOD calculate_item_total.

    rv_total = iv_quantity * iv_unit_price.

  ENDMETHOD.


  METHOD calculate_po_total.

    DATA lv_total TYPE z25de_total_amount.

    CLEAR: rv_total, lv_total.

    SELECT SUM( line_total )
      INTO lv_total
      FROM z25po_item
      WHERE po_id = iv_po_id.

    rv_total = lv_total.

  ENDMETHOD.


  METHOD create_purchase_order.

    DATA: lv_existing_po TYPE z25de_po_id,
          lv_total TYPE z25de_total_amount.

    CLEAR rv_success.

    "Check whether the PO header already exists
    SELECT SINGLE po_id
      INTO lv_existing_po
      FROM z25po_header
      WHERE po_id = is_header-po_id.

    "Create header only for a new PO
    IF sy-subrc <> 0.

      INSERT z25po_header FROM is_header.

      IF sy-subrc <> 0.
        ROLLBACK WORK.
        RETURN.
      ENDIF.

    ENDIF.

    "Insert the new PO item
    INSERT z25po_item FROM is_item.

    IF sy-subrc <> 0.
      ROLLBACK WORK.
      RETURN.
    ENDIF.

    "Recalculate total for all items in this PO
    SELECT SUM( line_total )
      INTO lv_total
      FROM z25po_item
      WHERE po_id = is_header-po_id.

    "Update header total
    UPDATE z25po_header
      SET total_amount = lv_total
      WHERE po_id = is_header-po_id.

    IF sy-subrc = 0.
      COMMIT WORK AND WAIT.
      rv_success = abap_true.
    ELSE.
      ROLLBACK WORK.
      rv_success = abap_false.
    ENDIF.

  ENDMETHOD.

  METHOD update_po_status.

    DATA lv_current_status TYPE z25de_status.

    CLEAR rv_success.

    SELECT SINGLE status
      INTO lv_current_status
      FROM z25po_header
      WHERE po_id = iv_po_id.

    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    "Only New or Released POs can be cancelled; only New POs can be released
    IF iv_status = 'R' AND lv_current_status <> 'N'.
      RETURN.
    ELSEIF iv_status = 'C'
       AND lv_current_status <> 'N'
       AND lv_current_status <> 'R'.
      RETURN.
    ENDIF.

    UPDATE z25po_header
      SET status = iv_status
      WHERE po_id = iv_po_id.

    IF sy-subrc = 0 AND sy-dbcnt = 1.
      COMMIT WORK AND WAIT.
      rv_success = abap_true.
    ELSE.
      ROLLBACK WORK.
      rv_success = abap_false.
    ENDIF.

  ENDMETHOD.

ENDCLASS.

